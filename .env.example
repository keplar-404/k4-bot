# Backend (apps/backend): copy to apps/backend/.dev.vars for local dev,
# use `wrangler secret put <NAME>` in production.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Only used by drizzle-kit (migrations); the pooled URL above is used at runtime.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:3000

# The agent's model provider (required) and optional web search.
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Composio (per-user connected apps: Gmail, Slack, GitHub, ...). Empty = connect feature disabled.
COMPOSIO_API_KEY=

# The computer (an E2B desktop per user). Empty = bots have no computer.
# It is billed per second while awake: keep the caps below low until you trust the setup.
E2B_API_KEY=
COMPUTER_MAX_MINUTES_PER_DAY=120
COMPUTER_IDLE_MINUTES=5
# COMPUTER_ALLOWED_HOSTS=example.com,wikipedia.org

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
WS_TOKEN_SECRET=
# Encrypts saved secrets and MCP tokens (AES-256-GCM). 32 random bytes, base64: `openssl rand -base64 32`.
# Without it, saving a secret answers 503. To rotate, move the old key to SECRETS_ENCRYPTION_KEY_PREVIOUS.
SECRETS_ENCRYPTION_KEY=
# Verifies app events (Slack message, new email…) Composio delivers to POST /api/v1/composio/events. It is the
# project's webhook subscription secret: run `bun run composio:webhook <public API URL>` once, then store what it prints.
COMPOSIO_WEBHOOK_SECRET=
# Production, when web and API are sibling subdomains (e.g. app.example.com / api.example.com):
# COOKIE_DOMAIN=example.com
MAX_RUNS_PER_USER=50
MAX_DAILY_TOKENS_PER_USER=2000000

# Frontend (apps/web/.env.local)
NEXT_PUBLIC_AUTH_URL=http://localhost:8787
