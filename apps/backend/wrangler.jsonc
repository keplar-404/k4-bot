{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_RELAY", "class_name": "ChatRelayDurableObject" },
      { "name": "USER_COMPUTER", "class_name": "UserComputerDurableObject" },
      { "name": "BOT_SANDBOX", "class_name": "BotSandbox" },
      { "name": "ASYNC_TASKS", "class_name": "AsyncTaskRegistry" },
      { "name": "WORKFLOW_LIVE", "class_name": "WorkflowRunRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRelayDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["UserComputerDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["BotSandbox"] },
    { "tag": "v4", "new_sqlite_classes": ["AsyncTaskRegistry"] },
    { "tag": "v5", "new_sqlite_classes": ["WorkflowRunRelay"] }
  ],
  // An agent step is mostly waiting on the network, but a slice of tool calls can use real CPU.
  // Subrequests are counted per Workflow instance (default 10,000): a run that lasts days makes far more
  // (model calls, relay events, database writes), so the cap is raised (allowed up to 10M).
  // https://developers.cloudflare.com/workflows/reference/limits/
  "limits": { "cpu_ms": 300000, "subrequests": 1000000 },
  // Files users upload, images bots create and files bots share from the computer. Downloads come from here,
  // so they work while the computer sleeps. Local dev simulates the bucket; production needs it created once.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "k4-bot-files" }],
  "workflows": [
    { "name": "chat-run", "binding": "CHAT_RUN", "class_name": "ChatRunWorkflow" },
    { "name": "async-task", "binding": "ASYNC_TASK", "class_name": "AsyncTaskWorkflow" },
    { "name": "workflow-run", "binding": "WORKFLOW_RUN", "class_name": "WorkflowRunner" },
    { "name": "assistant-run", "binding": "ASSISTANT_RUN", "class_name": "AssistantRunWorkflow" }
  ],
  "ratelimits": [
    // Every API request, per client IP.
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    // Mutating and expensive routes, per user.
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_WF_SAVE", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_WF_RUN", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // Public webhook calls (per workflow), Composio actions run by bots/workflows (per user), HTTP blocks (per user).
    { "name": "RL_WF_HOOK", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_APP_EXEC", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_HTTP", "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } },
    // Messages to the workflow assistant, per user.
    { "name": "RL_ASSISTANT_MSG", "namespace_id": "1008", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "WEB_ORIGIN": "http://localhost:3000"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
