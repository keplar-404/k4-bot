{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_RELAY", "class_name": "ChatRelayDurableObject" },
      { "name": "USER_COMPUTER", "class_name": "UserComputerDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRelayDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["UserComputerDurableObject"] }
  ],
  // An agent step is mostly waiting on the network, but a slice of tool calls can use real CPU.
  // Subrequests are counted per Workflow instance (default 10,000): a run that lasts days makes far more
  // (model calls, relay events, database writes), so the cap is raised (allowed up to 10M).
  // https://developers.cloudflare.com/workflows/reference/limits/
  "limits": { "cpu_ms": 300000, "subrequests": 1000000 },
  "workflows": [
    { "name": "chat-run", "binding": "CHAT_RUN", "class_name": "ChatRunWorkflow" }
  ],
  "ratelimits": [
    // Every API request, per client IP.
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    // Mutating and expensive routes, per user.
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "WEB_ORIGIN": "http://localhost:3000"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
