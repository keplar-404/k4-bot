{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check-types": "tsc --noEmit",
    "eval:coding": "bun --env-file=.dev.vars run scripts/evals/coding/run.ts",
    "check:relay-token": "bun run src/shared/relay-token.check.ts",
    "check:guards": "bun run src/modules/computer/guards.check.ts",
    "check:secrets": "bun run src/shared/secrets.check.ts",
    "check:retry": "bun run src/modules/chat/run/retry.check.ts",
    "check:documents": "bun run src/modules/files/documents/documents.check.ts && bun run src/modules/files/documents/office/office.check.ts",
    "check:sandbox": "bun run src/modules/sandbox/policy.check.ts && bun run src/modules/sandbox/paths.check.ts",
    "check:middleware": "bun run src/modules/agent/middleware/stack.check.ts && bun run src/modules/agent/middleware/todo-guard.check.ts",
    "check:web": "bun run src/modules/chat/commands.check.ts && bun run src/modules/agent/tools/web/research.check.ts && bun run src/modules/agent/tools/web/research-format.check.ts",
    "check": "bun run check:web && bun run check:relay-token && bun run check:guards && bun run check:secrets && bun run check:retry && bun run check:documents && bun run check:sandbox && bun run check:middleware",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "agent:chat": "bun --env-file=.dev.vars run src/modules/agent/cli.ts",
    "e2b:smoke": "bun --env-file=.dev.vars run scripts/e2b/desktop-smoke.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/mcp-adapters": "2.0.1",
    "@langchain/openrouter": "0.4.21",
    "@langchain/tavily": "^1.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.14",
    "deepagents": "^1.16.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "e2b": "2.62.0",
    "hono": "^4.13.14",
    "jszip": "3.10.1",
    "langchain": "^1.6.0",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@e2b/cli": "^2.23.0",
    "@e2b/desktop": "^2.5.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.110.0"
  }
}
