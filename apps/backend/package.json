{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check-types": "tsc --noEmit",
    "check:relay-token": "bun run src/lib/relay-token.check.ts",
    "check:stream": "bun run src/agent/stream.check.ts",
    "check": "bun run check:relay-token && bun run check:stream",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "agent:chat": "bun --env-file=.dev.vars run src/agent/cli.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/openai": "^1.8.0",
    "@langchain/tavily": "^1.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.14",
    "deepagents": "^1.16.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "langchain": "^1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.110.0"
  }
}
