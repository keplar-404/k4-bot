DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=
WEB_URL=http://localhost:3000
# Neon Auth public keys (`neon env pull` writes this): the backend checks user tokens with them.
NEON_AUTH_JWKS_URL=
# E2B desktops (created after sign-in)
E2B_API_KEY=
# Neon Object Storage (screenshot links). `neon env pull` writes the AWS_* vars.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
SCREENSHOT_BUCKET=screenshots
