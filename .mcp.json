{
  "mcpServers": {
    "shadcn": {
      "command": "bunx",
      "args": [
        "shadcn@latest",
        "mcp",
        "--cwd",
        "apps/web"
      ]
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "nextjs": {
      "type": "http",
      "url": "http://localhost:3000/_next/mcp"
    },
    "e2b-docs": {
      "type": "http",
      "url": "https://docs.e2b.dev/mcp"
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  }
}
