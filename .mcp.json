{
  "mcpServers": {
    "shadcn": {
      "command": "bunx",
      "args": [
        "shadcn@latest",
        "mcp",
        "--cwd",
        "apps/web"
      ]
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "e2b-docs": {
      "type": "http",
      "url": "https://docs.e2b.dev/mcp"
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "browser-use-docs": {
      "type": "http",
      "url": "https://docs.browser-use.com/mcp"
    },
    "brightdata-docs": {
      "type": "http",
      "url": "https://docs.brightdata.com/mcp"
    },
    "tavily-docs": {
      "type": "http",
      "url": "https://docs.tavily.com/mcp"
    },
    "tavily": {
      "type": "http",
      "url": "https://mcp.tavily.com/mcp/"
    }
  }
}
