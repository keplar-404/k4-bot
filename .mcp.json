{
  "mcpServers": {
    "shadcn": {
      "command": "bunx",
      "args": [
        "shadcn@latest",
        "mcp",
        "--cwd",
        "apps/web"
      ]
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "nextjs": {
      "type": "http",
      "url": "http://localhost:3000/_next/mcp"
    }
  }
}